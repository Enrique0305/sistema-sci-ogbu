# Copiar este archivo a ".env" y completar con los valores reales.
# Nunca subir el archivo ".env" real a un repositorio de codigo.

PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sci_ogbu
DB_USER=sci_ogbu_app
