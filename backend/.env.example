# Copiar este archivo a ".env" y completar con los valores reales.
# Nunca subir el archivo ".env" real a un repositorio de codigo.

PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sci_ogbu
DB_USER=sci_ogbu_app
DB_PASSWORD=cambiar_esta_clave

# Origen permitido para CORS (frontend). Separar multiples origenes con coma.
CORS_ORIGIN=http://localhost:5173

# --- Integracion Oracle SUM (solo lectura, vista OBIENESTAR.ALUMNO) ---
# Usada unicamente por "npm run sync:alumnos" (backend/src/scripts/syncAlumnosOracle.js).
# El servidor HTTP principal (npm run dev / npm start) NO requiere estas
# variables y sigue funcionando con normalidad si no estan configuradas.
ORACLE_USER=
ORACLE_PASSWORD=
# Alias tal como aparece en tnsnames.ora dentro del Wallet (puede variar,
# ej. SUMDB_TP_HIGH, SUMDB_TP_MEDIUM, SUMDB_TP_LOW).
ORACLE_DSN=SUMDB_TP_HIGH
# Carpeta del Wallet (cwallet.sso, ewallet.pem, tnsnames.ora, sqlnet.ora).
# Debe estar FUERA del repositorio (ver .gitignore).
ORACLE_WALLET_DIR=./oracle_wallet
ORACLE_WALLET_PASSWORD=
# Cantidad de periodos academicos mas recientes a sincronizar.
ORACLE_SYNC_PERIODOS_N=4
# Opcional: ruta a Oracle Instant Client (modo Thick). Solo necesario si
# ewallet.pem del Wallet esta cifrado y no se cuenta con esa contraseña
# (cwallet.sso si funciona sin password, pero requiere modo Thick).
ORACLE_INSTANT_CLIENT_DIR=
