# Variables usadas por docker-compose.yml en si (sustitucion de variables
# dentro del archivo), NO por la aplicacion directamente.
# Copiar a ".env" en la RAIZ del repo antes de "docker compose up".
# Es un archivo DISTINTO de backend/.env (ese sigue siendo obligatorio para
# PORT, ORACLE_USER/PASSWORD/DSN, etc. -- ver seccion Docker del README).
#
# IMPORTANTE: DB_NAME/DB_USER/DB_PASSWORD definidos aqui son los que
# realmente se usan al correr con Docker (los del contenedor "mysql" Y los
# que el backend usa para conectarse a el) -- pisan lo que haya en
# backend/.env para esas 3 claves, para que ambos contenedores nunca queden
# con credenciales distintas.

MYSQL_ROOT_PASSWORD=root_change_me
DB_NAME=sci_ogbu
DB_USER=sci_ogbu_app
DB_PASSWORD=cambiar_esta_clave

# Puerto HTTP por el que el sistema queda accesible en la red institucional.
#   http://IP-DEL-SERVIDOR:8080
HTTP_PORT=8080

# Origenes permitidos para CORS. Con el proxy de nginx no suele hacer falta
# tocarlo; "*" sirve para una herramienta interna. Para restringir:
#   CORS_ORIGIN=http://192.168.1.50:8080,http://sci.institucion.local
CORS_ORIGIN=*

# Ruta en el HOST de la carpeta del Wallet de Oracle, si vive en un lugar
# distinto a ./oracle_wallet junto a este archivo.
ORACLE_WALLET_HOST_DIR=./oracle_wallet

# Version/URL del Oracle Instant Client Basic para Linux x64, por si Oracle
# publica una version nueva y quieres fijar una especifica.
ORACLE_INSTANTCLIENT_URL=https://download.oracle.com/otn_software/linux/instantclient/2326300/instantclient-basic-linux.x64-23.26.3.0.0.zip
